# Copy to .env and replace placeholders. Never commit .env.

# PostgreSQL connection string. Local default matches `npm run db:local`.
DATABASE_URL=postgres://nova:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:54329/nova_os
# Used only by `npm run db:local` to initialise the embedded dev database.
LOCAL_DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
LOCAL_DB_PORT=54329

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
# Public base URL of the app (https:// in staging/production).
BETTER_AUTH_URL=http://localhost:3000

# Allow self-service sign-up (keep false until onboarding exists).
ALLOW_SIGNUP=false

# Password given to the fictional demo users created by `npm run db:seed`.
SEED_DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
